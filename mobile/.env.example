# Скопируйте в .env и подставьте IP компьютера, где запущен backend (npm run dev в папке backend), порт обычно 3000.
# Не используйте порт Metro (8081) — это другой сервис.
# После изменения перезапустите Expo: npx expo start -c
EXPO_PUBLIC_API_URL=http://192.168.1.5:3000

# --- Sentry observability (Phase 1) ---
# DSN из проекта mtbank-mobile в Sentry (см. Settings → Client Keys (DSN)).
# Пусто в локальной разработке — SDK тогда не инициализируется (silent skip).
EXPO_PUBLIC_SENTRY_DSN=
