{
  "expo": {
    "name": "MTBank",
    "slug": "mtbank",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mtbank",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mtbank.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Приложению нужен доступ к камере для сканирования QR-кодов",
        "NSFaceIDUsageDescription": "Используется для быстрого и безопасного входа в MTBank"
      }
    },
    "android": {
      "package": "com.mtbank.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Приложению нужен доступ к камере для сканирования QR-кодов",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Используется для быстрого и безопасного входа в MTBank"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
