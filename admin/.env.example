# URL бэкенда для прокси Vite (dev и `vite preview`). По умолчанию http://127.0.0.1:3000
ADMIN_BACKEND_URL=http://127.0.0.1:3000

# Рекомендуется для `npm run dev` и для `vite preview` / вкладки Preview: прямой origin API.
# Дублируется в .env.development — при смене порта backend поправьте и здесь, и там.
# VITE_API_ORIGIN=http://127.0.0.1:3000

# Если админка на другом домене без /api proxy:
# VITE_API_BASE_URL=http://127.0.0.1:3000

# --- Sentry observability (Phase 1) ---
# Browser-exposed DSN из проекта mtbank-admin в Sentry (Settings → Client Keys (DSN)).
# Пусто в локальной разработке — SDK тогда не инициализируется (silent skip).
VITE_SENTRY_DSN=

# CI-only secrets for sourcemap upload (NEVER commit values; CI Github Actions secrets only).
# admin/vite.config.js gates the sentryVitePlugin on ALL THREE being present.
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=
