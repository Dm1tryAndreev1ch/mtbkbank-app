generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  STANDARD
  SILVER
  GOLD
  PLATINUM
  BLOCKED
}

enum Rarity {
  COMMON
  RARE
  EPIC
  LEGENDARY
}

enum CardSource {
  PURCHASE
  TRADE
  QUEST
  ADMIN
  GIFT
  SHOP
}

enum TradeStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
}

enum TransactionType {
  PURCHASE
  TRANSFER_IN
  TRANSFER_OUT
  TOPUP
  PAYMENT
  SUBSCRIPTION
  ADMIN_ADJUSTMENT
}

enum QuestType {
  DAILY
  WEEKLY
}

model User {
  id            String     @id @default(cuid())
  name          String
  phone         String     @unique
  pin           String
  avatarUrl     String?
  expoPushToken String?
  refreshToken  String? // FIX: stored for revocation support
  // Phase 4 / 04-02 / B-M2 — expiry stamp written at issuance (login/register/refresh
  // rotation). NULL means "legacy token issued before this column existed"; backfill
  // migration sets such rows to createdAt + 30d so the historical fleet does not
  // retain unbounded validity.
  refreshTokenExpiresAt DateTime?
  mbPoints      Int        @default(0)
  status        UserStatus @default(STANDARD)
  isAdmin       Boolean    @default(false)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  accounts       BankAccount[]
  bankCards      BankCard[]
  userCards      UserCard[]
  decks          Deck[]
  tradesFrom     CardTrade[]     @relation("TradesFrom")
  tradesTo       CardTrade[]     @relation("TradesTo")
  userQuests     UserQuest[]
  subscriptions  Subscription[]
  spendingLimits SpendingLimit[]
  notifications  Notification[]
  transactions   Transaction[]
  auditLogs      AuditLog[]      @relation("AuditActor")
}

model BankAccount {
  id        String   @id @default(cuid())
  userId    String
  name      String
  type      String
  balance   Float    @default(0)
  currency  String   @default("RUB")
  createdAt DateTime @default(now())

  user             User          @relation(fields: [userId], references: [id])
  bankCards        BankCard[]
  transactionsFrom Transaction[] @relation("TransFrom")
  transactionsTo   Transaction[] @relation("TransTo")
}

model BankCard {
  id           String   @id @default(cuid())
  userId       String
  accountId    String
  maskedNumber String
  type         String
  tier         String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  user    User        @relation(fields: [userId], references: [id])
  account BankAccount @relation(fields: [accountId], references: [id])
}

model Transaction {
  id            String          @id @default(cuid())
  userId        String
  fromAccountId String?
  toAccountId   String?
  amount        Float
  currency      String          @default("RUB")
  type          TransactionType
  category      String?
  merchant      String?
  merchantIcon  String?
  description   String?
  status        String          @default("completed")
  scheduledAt   DateTime?
  droppedCardId String?
  createdAt     DateTime        @default(now())

  user        User         @relation(fields: [userId], references: [id])
  fromAccount BankAccount? @relation("TransFrom", fields: [fromAccountId], references: [id])
  toAccount   BankAccount? @relation("TransTo", fields: [toAccountId], references: [id])

  // Phase 4 / 04-02 / B-M4 — paired with hand-written CONCURRENT index migration
  // (20260427_idx_transaction_user_created). `map:` aligns Prisma's expected name
  // with the SQL we ship so `prisma migrate diff` does not propose a duplicate.
  @@index([userId, createdAt(sort: Desc)], map: "Transaction_userId_createdAt_idx")
}

model CollectionCard {
  id               String   @id @default(cuid())
  name             String
  brandName        String
  brandIcon        String
  brandLogo        String?
  imageUrl         String?
  description      String?
  rarity           Rarity
  cashbackPercent  Float
  cashbackCategory String?
  mbValue          Int      @default(0)
  mbPrice          Int? // FIX: shop price; falls back to rarity default if null
  maxHealth        Int      @default(100)
  dropRate         Float    @default(0)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())

  userCards UserCard[]
}

model UserCard {
  id               String     @id @default(cuid())
  userId           String
  collectionCardId String
  health           Int        @default(100)
  source           CardSource @default(PURCHASE)
  acquiredAt       DateTime   @default(now())
  lastWarningAt    DateTime? // REL-11 — null = never warned; updated by tickActiveDeckCardHealth on low-HP push

  user           User           @relation(fields: [userId], references: [id])
  collectionCard CollectionCard @relation(fields: [collectionCardId], references: [id])
  deckCards      DeckCard[]

  @@unique([userId, collectionCardId])
  // Phase 4 / 04-02 / B-M4 — paired with 20260427_idx_user_card_user CONCURRENT
  // migration. The (userId, collectionCardId) unique already implicitly indexes
  // userId-prefix queries, but Prisma's diff-engine treats explicit @@index as
  // the contract for `map:` alignment with the SQL.
  @@index([userId], map: "UserCard_userId_idx")
}

model Deck {
  id        String   @id @default(cuid())
  userId    String
  name      String
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User       @relation(fields: [userId], references: [id])
  deckCards DeckCard[]
}

model DeckCard {
  id         String @id @default(cuid())
  deckId     String
  userCardId String
  slotIndex  Int

  deck     Deck     @relation(fields: [deckId], references: [id], onDelete: Cascade)
  userCard UserCard @relation(fields: [userCardId], references: [id], onDelete: Cascade)

  @@unique([deckId, slotIndex])
  @@unique([deckId, userCardId])
}

model CardTrade {
  id              String      @id @default(cuid())
  fromUserId      String
  toUserId        String?
  offeredCardId   String
  requestedCardId String?
  mbPointsOffer   Int         @default(0)
  status          TradeStatus @default(PENDING)
  isGift          Boolean     @default(false)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  fromUser User  @relation("TradesFrom", fields: [fromUserId], references: [id])
  toUser   User? @relation("TradesTo", fields: [toUserId], references: [id])
}

model Quest {
  id           String    @id @default(cuid())
  title        String
  description  String
  icon         String
  rewardMB     Int       @default(0)
  rewardCardId String?
  type         QuestType
  condition    String
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())

  userQuests UserQuest[]
}

model UserQuest {
  id          String    @id @default(cuid())
  userId      String
  questId     String
  progress    Int       @default(0)
  target      Int       @default(1)
  completed   Boolean   @default(false)
  claimed     Boolean   @default(false)
  completedAt DateTime?
  assignedAt  DateTime  @default(now())

  user  User  @relation(fields: [userId], references: [id])
  quest Quest @relation(fields: [questId], references: [id])

  @@unique([userId, questId, assignedAt])
}

model Subscription {
  id          String   @id @default(cuid())
  userId      String
  name        String
  icon        String
  amount      Float
  currency    String   @default("RUB")
  category    String   @default("Другое")
  nextPayment DateTime
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model SpendingLimit {
  id          String   @id @default(cuid())
  userId      String
  category    String
  limitAmount Float
  spentAmount Float    @default(0)
  period      String   @default("monthly")
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, category])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  body      String
  icon      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  // Phase 4 / 04-02 / B-M4 — paired with 20260427_idx_notification_user_created
  // CONCURRENT migration; supports the listing query "user notifications most-recent-first".
  @@index([userId, createdAt(sort: Desc)], map: "Notification_userId_createdAt_idx")
}

model SystemConfig {
  id    String @id @default(cuid())
  key   String @unique
  value String
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String
  actor      User     @relation("AuditActor", fields: [actorId], references: [id])
  action     String // DOMAIN_REASON code, e.g. 'USER_HARD_DELETE', 'ACCOUNT_FREEZE'
  targetType String // 'User' | 'BankAccount' | 'Transaction' | …
  targetId   String?
  payload    Json // { before, after, reason, … } — already PII-scrubbed
  requestId  String?
  createdAt  DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([targetType, targetId])
}
