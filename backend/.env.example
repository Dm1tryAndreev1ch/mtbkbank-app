# ===========================================================================
# backend/.env.example
# Copy to backend/.env and fill in real values for local dev.
# NEVER commit a populated .env file.
# envalid (backend/src/env.js) validates these on boot; missing required vars
# cause backend to exit non-zero with a readable stderr report.
# ===========================================================================

# --- Database (REQUIRED everywhere) ---
DATABASE_URL=postgresql://localhost:5432/mtbank_dev

# --- JWT secrets (REQUIRED everywhere — no fallback) ---
JWT_SECRET=CHANGE_ME_IN_PROD
JWT_REFRESH_SECRET=CHANGE_ME_IN_PROD_TOO

# --- Redis (REQUIRED in production; dev falls back to localhost) ---
REDIS_URL=redis://localhost:6379

# --- CORS (REQUIRED in production; dev falls back to localhost ports) ---
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8081

# --- Sentry observability (REQUIRED in production; empty in dev = SDK skipped) ---
# Get DSN from https://sentry.io/ → mtbank-backend project → Settings → Client Keys (DSN)
SENTRY_DSN=

# --- Logging ---
LOG_LEVEL=info

# --- Build metadata (set by CI in production; defaults to "dev") ---
BUILD_SHA=

# --- Environment ---
NODE_ENV=development
PORT=3000

# --- Active-deck HP decay (existing; cardEngine.tickActiveDeckCardHealth) ---
ACTIVE_DECK_HP_TICK_MS=60000
ACTIVE_DECK_HP_LOSS_PER_TICK=1
ACTIVE_DECK_LOW_HP_THRESHOLD=30
