DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/mtbbank
REDIS_URL=redis://localhost:6379
JWT_SECRET=CHANGE_ME_USE_A_LONG_RANDOM_SECRET
PORT=3000
NODE_ENV=development

# Active deck: cards in the active deck lose HP on a timer (see cardEngine.tickActiveDeckCardHealth)
# Runs on the server while the API is up; closing the app does not stop HP loss.
# Time between HP loss ticks in milliseconds (60000 = 60 seconds)
ACTIVE_DECK_HP_TICK_MS=60000
# HP subtracted each tick (default 1)
ACTIVE_DECK_HP_LOSS_PER_TICK=1
# In-app warning when HP crosses into this zone (from above); default 30
ACTIVE_DECK_LOW_HP_THRESHOLD=30
